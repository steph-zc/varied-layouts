<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Login" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Usado nas telas internas: mantem as cores do Theme.Login, mas sem a barra de titulo. -->
    <style name="Theme.Login.NoActionBar" parent="Theme.Login">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Sem a ActionBar o fundo claro fica atras da status bar, entao os icones dela precisam ser escuros. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
